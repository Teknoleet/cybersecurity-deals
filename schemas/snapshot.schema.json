{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deals.teknoleet.com/schemas/snapshot.schema.json",
  "title": "CyberDeals 2026 public snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "edition", "generated_at", "collection", "sources", "deals"],
  "properties": {
    "schema_version": {"const": 1},
    "edition": {"const": 2026},
    "generated_at": {"$ref": "#/$defs/timestamp"},
    "collection": {
      "type": "object", "additionalProperties": false,
      "required": ["last_completed_at", "source_count", "successful_sources", "failed_sources"],
      "properties": {
        "last_completed_at": {"$ref": "#/$defs/nullableTimestamp"},
        "source_count": {"type": "integer", "minimum": 0},
        "successful_sources": {"type": "integer", "minimum": 0},
        "failed_sources": {"type": "integer", "minimum": 0}
      }
    },
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "deals": {"type": "array", "items": {"$ref": "#/$defs/deal"}}
  },
  "$defs": {
    "timestamp": {"type": "string", "format": "date-time", "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"},
    "nullableTimestamp": {"anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
    "url": {"type": "string", "format": "uri", "pattern": "^https?://[^/]+"},
    "text": {"type": "string", "maxLength": 6000},
    "nullableText": {"type": ["string", "null"], "maxLength": 2000},
    "price": {"type": ["number", "null"], "minimum": 0},
    "currency": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"},
    "category": {"enum": ["training", "certifications", "software", "hardware", "books"]},
    "topic": {"enum": ["offensive-security", "blue-team-dfir", "appsec", "cloud-devsecops", "ai-security", "osint", "reverse-engineering", "hardware-physical", "privacy-vpn", "llm-security", "agent-security", "mcp-security", "adversarial-ml", "ai-for-security"]},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "url", "type", "adapter", "status", "last_attempt_at", "last_successful_fetch_at", "last_offer_confirmed_at", "offers_count", "note"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "url": {"$ref": "#/$defs/url"},
        "type": {"enum": ["official", "github", "roundup", "marketplace", "community"]},
        "adapter": {"type": ["string", "null"]},
        "status": {"enum": ["confirmed", "discovery", "historical", "unavailable", "unsupported", "not_checked"]},
        "last_attempt_at": {"$ref": "#/$defs/nullableTimestamp"},
        "last_successful_fetch_at": {"$ref": "#/$defs/nullableTimestamp"},
        "last_offer_confirmed_at": {"$ref": "#/$defs/nullableTimestamp"},
        "offers_count": {"type": "integer", "minimum": 0},
        "note": {"$ref": "#/$defs/text"}
      }
    },
    "deal": {
      "type": "object",
      "description": "Additional evidence/provenance fields are allowed; required public keys are stable. No raw HTML is rendered.",
      "additionalProperties": true,
      "required": ["id", "vendor", "product", "description", "category", "topics", "campaign_type", "campaign_year", "eligibility_basis", "eligibility_evidence", "source_id", "source_url", "discovery_urls", "offer_url", "coupon", "currency", "sale_price", "regular_price", "discount_percent", "billing_period", "conditions", "starts_at", "ends_at", "expiry_label", "verification_status", "last_offer_confirmed_at", "first_seen_at", "price_history", "evidence_excerpt", "marketplace"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-f0-9]{24}$"},
        "vendor": {"type": "string", "minLength": 1, "maxLength": 1000},
        "product": {"type": "string", "minLength": 1, "maxLength": 1000},
        "description": {"$ref": "#/$defs/text"},
        "category": {"$ref": "#/$defs/category"},
        "topics": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/topic"}},
        "campaign_type": {"enum": ["black_friday", "general_promotion"]},
        "campaign_year": {"const": 2026},
        "eligibility_basis": {"enum": ["explicit_2026", "october_2026"]},
        "eligibility_evidence": {
          "type": "object", "required": ["official_corroboration"],
          "properties": {
            "campaign_text": {"$ref": "#/$defs/text"},
            "official_corroboration": {"const": true},
            "original_published_at": {"$ref": "#/$defs/nullableTimestamp"},
            "original_date_verified": {"type": "boolean"},
            "original_date_source": {"$ref": "#/$defs/nullableText"},
            "checkout_tested": {"const": false}
          }, "additionalProperties": true
        },
        "source_id": {"type": "string", "minLength": 1},
        "source_url": {"$ref": "#/$defs/url"},
        "discovery_urls": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/url"}},
        "offer_url": {"$ref": "#/$defs/url"},
        "coupon": {"$ref": "#/$defs/nullableText"},
        "currency": {"$ref": "#/$defs/currency"},
        "currency_symbol": {"type": "string", "maxLength": 10},
        "sale_price": {"$ref": "#/$defs/price"},
        "regular_price": {"$ref": "#/$defs/price"},
        "discount_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "billing_period": {"$ref": "#/$defs/nullableText"},
        "conditions": {"type": "array", "items": {"$ref": "#/$defs/text"}},
        "starts_at": {"$ref": "#/$defs/nullableTimestamp"},
        "ends_at": {"$ref": "#/$defs/nullableTimestamp"},
        "expiry_label": {"$ref": "#/$defs/nullableText"},
        "verification_status": {"enum": ["vendor_published", "marketplace_published"]},
        "last_offer_confirmed_at": {"$ref": "#/$defs/timestamp"},
        "first_seen_at": {"$ref": "#/$defs/timestamp"},
        "price_history": {
          "type": "array", "maxItems": 90,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["at", "price", "currency"],
            "properties": {"at": {"$ref": "#/$defs/timestamp"}, "price": {"type": "number", "minimum": 0}, "currency": {"$ref": "#/$defs/currency"}}
          }
        },
        "evidence_excerpt": {"$ref": "#/$defs/text"},
        "marketplace": {"type": "boolean"},
        "offer_timing": {"enum": ["upcoming", "month_window_unknown_timezone"]},
        "reference_price_basis": {"const": "vendor_advertised"},
        "scope": {"type": "array", "items": {"type": "string"}},
        "provenance": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/url"}}
      }
    }
  }
}
